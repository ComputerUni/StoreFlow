﻿@using X.PagedList.Mvc.Core
@model X.PagedList.IPagedList<Category>

@{
    ViewData["Title"] = "CategoryList";
    Layout = "~/Views/Layout/Index.cshtml";
}

@* <h3>@ViewBag.v</h3>
<h3>@ViewBag.v2</h3> *@

<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title font-weight-bold">Tersten Kategoriler</h4>
                <p class="card-description">
                    <code>Kategori ile ilgili işlemlerinizi buradan yapabilirsiniz.</code>
                </p>
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Kategori ID</th>
                                <th>Kategori Adı</th>
                                <th>Durum</th>
                                <th>İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.CategoryId</td>
                                    <td>@item.CategoryName</td>
                                    <td>
                                        @if (item.CategoryStatus == true)
                                        {
                                            <a href="/Category/ChangeStatus/@item.CategoryId" class="btn btn-success btn-sm">Aktif</a>
                                        }
                                        else
                                        {
                                            <a href="/Category/ChangeStatus/@item.CategoryId" class="btn btn-danger btn-sm">Pasif</a>
                                        }
                                    </td>
                                    <td style="display: flex; gap: 8px;">
                                        <a href="/Category/DeleteCategory/@item.CategoryId" class="btn btn-outline-danger"><i class="fa fa-trash"></i></a>
                                        <a href="/Category/UpdateCategory/@item.CategoryId" class="btn btn-outline-warning"><i class="fa fa-pencil-alt"></i></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <a href="/Category/AddCategory/" class="btn btn-outline-info"><i class="fa fa-plus"></i>   Yeni Kategori</a>
                </div>
                <div class="d-flex align-items-center justify-content-end mt-4 pt-3 border-top">
                    @Html.PagedListPager(Model, page => Url.Action("CategoryList", new { page }), new PagedListRenderOptions
                    {
                        UlElementClasses = new[] { "pagination", "mb-0" },
                        LiElementClasses = new[] { "page-item" },
                        PageClasses = new[] { "page-link" }
                    })
                </div>
            </div>
        </div>
    </div>
</div>

