@model Todo

@{
    ViewData["Title"] = "CreateTodo";
    Layout = "~/Views/Layout/Index.cshtml";
}

<div class="row">
    <div class="col-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Yapılacak Güncelleme</h4>
                <p class="card-description">
                    Yapılacak güncelleme işlemlerinizi buradan yönetebilirsiniz.
                </p>
                <form class="forms-sample" method="post">
                    <input type="hidden" asp-for="TodoId" />
                    <div class="form-group">
                        <label for="exampleInputName1">Açıklama</label>
                        <input type="text" asp-for="Description" class="form-control" id="exampleInputName1" placeholder="Ürün Adını Yazınız...">
                    </div>
                    <div class="form-group">
                        <div class="form-check form-check-flat form-check-primary">
                            <label class="form-check-label">
                                <input type="checkbox" asp-for="Status" class="form-check-input">
                                Durum Aktif mi?
                                <i class="input-helper"></i>
                            </label>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="exampleInputName1">Öncelik</label>
                        <input type="text" asp-for="Priority" class="form-control" id="exampleInputName1" placeholder="Ürün Adını Yazınız...">
                    </div>
                    <button type="submit" class="btn btn-outline-success mr-2">Güncelle</button>
                    <a href="/Todo/Index" class="btn btn-outline-danger">İptal</a>
                </form>
            </div>
        </div>
    </div>
</div>