﻿@using X.PagedList.Mvc.Core
@model X.PagedList.IPagedList<Todo>

@{
    ViewData["Title"] = "TodoList";
    Layout = "~/Views/Layout/Index.cshtml";
    int count = 0;
}


<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title font-weight-bold">Yapılacaklar</h4>
                <p class="card-description">
                    <code>Yapılacaklar ile ilgili işlemlerinizi buradan yapabilirsiniz.</code>
                </p>
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Açıklama</th>
                                <th>Durum</th>
                                <th>Öncelik</th>
                                <th>İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                count++;
                                <tr>
                                    <td>@count</td>
                                    <td>@item.Description</td>
                                    <td>
                                        @if (item.Status == true)
                                        {
                                            <a href="/Todo/ChangeStatus/@item.TodoId" class="btn btn-outline-success btn-sm">Aktif</a>
                                        }
                                        else
                                        {
                                            <a href="/Todo/ChangeStatus/@item.TodoId" class="btn btn-outline-danger btn-sm">Pasif</a>
                                        }
                                    </td>
                                    <td>
                                        @if(item.Priority == "Birincil")
                                        {
                                            <span class="text-danger">Birincil</span>
                                        }
                                        else if (item.Priority == "İkincil")
                                        {
                                            <span class="text-black">İkincil</span>
                                        }
                                        else if (item.Priority == "Üçüncül")
                                        {
                                            <span class="text-success">Üçüncül</span>
                                        }
                                        else if (item.Priority == "Dördüncül")
                                        {
                                            <span class="text-info">Dördüncül</span>
                                        }
                                    </td>
                                    <td style="display: flex; gap: 8px;">
                                        <a href="/Todo/Delete/@item.TodoId" class="btn btn-outline-danger"><i class="fa fa-trash"></i></a>
                                        <a href="/Todo/UpdateTodo/@item.TodoId" class="btn btn-outline-warning"><i class="fa fa-pencil-alt"></i></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <a href="/Todo/CreateTodo/" class="btn btn-outline-warning"><i class="fa fa-plus"></i>   Yeni Yapılacak</a>
                </div>
                <div class="d-flex align-items-center justify-content-end mt-4 pt-3 border-top">
                    @Html.PagedListPager(Model, page => Url.Action("Index", new { page }), new PagedListRenderOptions
                    {
                        UlElementClasses = new[] { "pagination", "mb-0" },
                        LiElementClasses = new[] { "page-item" },
                        PageClasses = new[] { "page-link" }
                    })
                </div>
            </div>
        </div>
    </div>
</div>

