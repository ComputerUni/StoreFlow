﻿@using X.PagedList.Mvc.Core
@model X.PagedList.IPagedList<Activity>

@{
    ViewData["Title"] = "ActivityList";
    Layout = "~/Views/Layout/Index.cshtml";
    int count = 0;
}


<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title font-weight-bold">Aktiviteler</h4>
                <p class="card-description">
                    <code>Aktivite ile ilgili işlemlerinizi buradan yapabilirsiniz.</code>
                </p>
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Başlık</th>
                                <th>İçerik</th>
                                <th>Tarih</th>
                                <th>İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                count++;
                                <tr>
                                    <td>@count</td>
                                    <td>@item.Title</td>
                                    <td>@item.Description</td>
                                    <td>@item.ActivityTime</td>
                                    
                                    <td style="display: flex; gap: 8px;">
                                        <a href="/Activity/DeleteActivity/@item.ActivityId" class="btn btn-outline-danger"><i class="fa fa-trash"></i></a>
                                        <a href="/Activity/UpdateActivity/@item.ActivityId" class="btn btn-outline-warning"><i class="fa fa-pencil-alt"></i></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <a href="/Activity/CreateActivity/" class="btn btn-outline-info"><i class="fa fa-plus"></i>   Yeni Aktivite</a>
                </div>
                <div class="d-flex align-items-center justify-content-end mt-4 pt-3 border-top">
                    @Html.PagedListPager(Model, page => Url.Action("ActivityList", new { page }), new PagedListRenderOptions
                    {
                        UlElementClasses = new[] { "pagination", "mb-0" },
                        LiElementClasses = new[] { "page-item" },
                        PageClasses = new[] { "page-link" }
                    })
                </div>
            </div>
        </div>
    </div>
</div>