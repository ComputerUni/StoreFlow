﻿@using X.PagedList.Mvc.Core
@model X.PagedList.IPagedList<Customer>

@{
    ViewData["Title"] = "CustomersCityList";
    Layout = "~/Views/Layout/Index.cshtml";
    int count = 0;
}

<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title font-weight-bold">Müşteriler (İstanbul Hariç)</h4>
                <p class="card-description">
                    <code>Müşteri ile ilgili işlemlerinizi buradan yapabilirsiniz.</code>
                </p>
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Müşteri Adı</th>
                                <th>Müşteri Şehir</th>
                                <th>Bakiye</th>
                                <th>İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                count++;
                                <tr>
                                    <td>@count</td>
                                    <td>@item.CustomerName @item.CustomerSurname</td>
                                    <td>@item.CustomerCity / @item.CustomerDistrict</td>
                                    <td>@item.CustomerBalance</td>
                                    <td style="display: flex; gap: 8px;">
                                        <a href="/Customer/DeleteCustomer/@item.CustomerId" class="btn btn-outline-danger"><i class="fa fa-trash"></i></a>
                                        <a href="/Customer/UpdateCustomer/@item.CustomerId" class="btn btn-outline-warning"><i class="fa fa-pencil-alt"></i></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <a href="/Customer/CreateCustomer/" class="btn btn-outline-info mt-2"><i class="fa fa-plus"></i>   Yeni Müşteri</a>
                </div>
                <div class="d-flex align-items-center justify-content-end mt-4 pt-3 border-top">
                    @Html.PagedListPager(Model, page => Url.Action("CustomerListOrderByCustomerName", new { page }), new PagedListRenderOptions
                    {
                        UlElementClasses = new[] { "pagination", "mb-0" },
                        LiElementClasses = new[] { "page-item" },
                        PageClasses = new[] { "page-link" }
                    })
                </div>
            </div>
        </div>
    </div>
</div>