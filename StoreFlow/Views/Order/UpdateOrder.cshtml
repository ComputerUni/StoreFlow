@model Order

@{
    ViewData["Title"] = "CreateOrder";
    Layout = "~/Views/Layout/Index.cshtml";
}

<div class="row">
    <div class="col-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Sipariş Güncelleme</h4>
                <p class="card-description">
                    Sipariş güncelleme işlemlerinizi buradan yönetebilirsiniz.
                </p>
                <form class="forms-sample" method="post">
                    <input type="hidden" asp-for="OrderId" />
                    <div class="form-group">
                        <label for="exampleInputName1">Ürün Seçiniz</label>
                        <select asp-for="ProductId" asp-items="@ViewBag.products" class="form-control">
                            <option value="">-- Ürün Seçiniz --</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="exampleInputName1">Müşteri Seçiniz</label>
                        <select asp-for="CustomerId" asp-items="@ViewBag.customers" class="form-control">
                            <option value="">-- Müşteri Seçiniz --</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="exampleInputName1">Sipariş Adet</label>
                        <input type="text" asp-for="OrderCount" id="orderCount" class="form-control" id="exampleInputName1" placeholder="Sipariş Adetini Yazınız...">
                    </div>

                    <div class="form-group">
                        <label for="exampleInputName1">Birim Fiyat</label>
                        <input type="text" asp-for="UnitPrice" id="unitPrice" class="form-control" id="exampleInputName1" placeholder="Birim Fiyatı Yazınız...">
                    </div>

                    <div class="form-group">
                        <label for="exampleInputName1">Toplam Fiyat</label>
                        <input type="text" asp-for="TotalPrice" id="totalPrice" class="form-control" id="exampleInputName1" placeholder="Toplam Fiyatı Yazınız...">
                    </div>

                    <div class="form-group">
                        <label for="exampleInputName1">Sipariş Durumu Seçiniz</label>
                        <select asp-for="Status" asp-items="@ViewBag.status" class="form-control">
                            <option value="">-- Sipariş Durumunu Seçiniz --</option>
                        </select>
                    </div>


                    <button type="submit" class="btn btn-outline-success mr-2">Güncelle</button>
                    <a href="/Order/OrderListAsync2" class="btn btn-outline-danger">İptal</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function calculate() {
            var unit = parseFloat(document.getElementById('unitPrice').value) || 0;
            var count = parseFloat(document.getElementById('orderCount').value) || 0;
            document.getElementById('totalPrice').value = (unit * count).toFixed(2);
        }

        document.getElementById('orderCount').addEventListener('input', calculate);
        document.getElementById('unitPrice').addEventListener('input', calculate);
    </script>
}