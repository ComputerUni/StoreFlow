@model List<Order>
@{
    ViewData["Title"] = "OrderListByStatus";
    Layout = "~/Views/Layout/Index.cshtml";
}

<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title font-weight-bold">Siparişler 2</h4>
                <p class="card-description">
                    <code>Siparişin durumu ile ilgili işlemlerinizi buradan yapabilirsiniz.</code>
                </p>
                <div class="table-responsive">

                    <form asp-action="OrderListSearch" method="get">
                        <div class="d-flex align-items-end gap-2 mb-5">
                            <div class="col-md-5">
                                <label>Arama</label>
                                <input type="text" name="name" placeholder="Örnek: Taşıma durumunda" class="form-control" />
                            </div>
                            <div class="col-md-5">
                                <label>Filtre Tipi</label>
                                <select name="filterType" class="form-control">
                                    <option value="start">Bu harflerle başlıyorsa</option>
                                    <option value="end">Bu harflerle bitiyorsa</option>
                                </select>
                            </div>
                            <div>
                                <button type="submit" class="btn btn-outline-info">Ara</button>
                            </div>
                        </div>

                    </form>

                    <table class="table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Ürün Adı</th>
                                <th>Müşteri</th>
                                <th>Sipariş Adet</th>
                                <th>Birim Fiyat</th>
                                <th>Toplam Fiyat</th>
                                <th>Durum</th>
                                <th>İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.OrderId</td>
                                    <td>@item.Product.ProductName</td>
                                    <td>@item.Customer.CustomerName @item.Customer.CustomerSurname</td>
                                    <td>@item.UnitPrice TL</td>
                                    <td>@item.TotalPrice TL</td>
                                    <td>@item.Status</td>

                                    <td style="display: flex; gap: 8px;">
                                        <a href="/Order/DeleteOrder/@item.OrderId" class="btn btn-outline-danger"><i class="fa fa-trash"></i></a>
                                        <a href="/Order/UpdateOrder/@item.OrderId" class="btn btn-outline-warning"><i class="fa fa-pencil-alt"></i></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <a href="/Order/CreateOrder/" class="btn btn-outline-info mt-2"><i class="fa fa-plus"></i>   Yeni Sipariş</a>
                </div>
            </div>
        </div>
    </div>
</div>