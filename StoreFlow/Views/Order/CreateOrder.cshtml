@model Order

@{
    ViewData["Title"] = "CreateOrder";
    Layout = "~/Views/Layout/Index.cshtml";
}

<div class="row">
    <div class="col-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Sipariş Ekleme</h4>
                <p class="card-description">
                    Sipariş ekleme işlemlerinizi buradan yönetebilirsiniz.
                </p>
                <form class="forms-sample" method="post">
                    <div class="form-group">
                        <label for="exampleInputName1">Ürün Seçiniz</label>
                        <select asp-for="ProductId" asp-items="@ViewBag.products" class="form-control">
                            <option value="">-- Ürün Seçiniz --</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="exampleInputName1">Müşteri Seçiniz</label>
                        <select asp-for="CustomerId" asp-items="@ViewBag.customers" class="form-control">
                            <option value="">-- Müşteri Seçiniz --</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="exampleInputName1">Sipariş Adet</label>
                        <input type="text" asp-for="OrderCount" class="form-control" id="exampleInputName1" placeholder="Sipariş Adetini Yazınız...">
                    </div>
                 
                    <div class="form-group">
                        <label for="exampleInputName1">Birim Fiyat</label>
                        <input type="text" asp-for="UnitPrice" class="form-control" id="exampleInputName1" placeholder="Birim Fiyatı Yazınız...">
                    </div>

                    <div class="form-group">
                        <label for="exampleInputName1">Toplam Fiyat</label>
                        <input type="text" asp-for="TotalPrice" class="form-control" id="exampleInputName1" placeholder="Toplam Fiyatı Yazınız...">
                    </div>

                    <button type="submit" class="btn btn-outline-success mr-2">Ekle</button>
                    <a href="/Order/OrderListAsync2" class="btn btn-outline-danger">İptal</a>
                </form>
            </div>
        </div>
    </div>
</div>