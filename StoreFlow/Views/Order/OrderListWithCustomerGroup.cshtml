﻿@using X.PagedList.Mvc.Core
@model X.PagedList.IPagedList<CustomerOrderViewModel>

@{
    ViewData["Title"] = "OrderListWithCustomerGroup";
    Layout = "~/Views/Layout/Index.cshtml";
    int count = 0;
}

<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title font-weight-bold">Müşterilerin Ürün Siparişleri</h4>
                <p class="card-description">
                    <code>Sipariş ile ilgili işlemlerinizi buradan yapabilirsiniz.</code>
                </p>
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Müşteri Adı</th>
                                <th>Sipariş</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                count++;
                                <tr>
                                    <td>@count</td>
                                    <td>@item.CustomerName</td>
                                    <td>
                                        @if (item.Orders.Any())
                                        {
                                            <ul class="list-group">
                                                @foreach (var order in item.Orders)
                                                {
                                                    <li>Sipariş No: @order.OrderId</li>
                                                }
                                            </ul>
                                        }
                                        else
                                        {
                                            <p class="text-danger">Bu müşterinin hiç siparişi yok</p>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <div class="d-flex align-items-center justify-content-end mt-4 pt-3 border-top">
                        @Html.PagedListPager(Model, page => Url.Action("OrderListWithCustomerGroup", new { page }), new PagedListRenderOptions
                        {
                            UlElementClasses = new[] { "pagination", "mb-0" },
                            LiElementClasses = new[] { "page-item" },
                            PageClasses = new[] { "page-link" }
                        })
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
