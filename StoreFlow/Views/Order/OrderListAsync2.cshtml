﻿@using X.PagedList.Mvc.Core
@model X.PagedList.IPagedList<Order>
@{
    ViewData["Title"] = "OrderListByStatus";
    Layout = "~/Views/Layout/Index.cshtml";
}

<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title font-weight-bold">Asenkron Siparişler</h4>
                <p class="card-description">
                    <code>Sipariş ile ilgili işlemlerinizi buradan yapabilirsiniz.</code>
                </p>
                <div class="table-responsive">

                    <table class="table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Ürün Adı</th>
                                <th>Müşteri</th>
                                <th style="text-center">Sipariş Adet</th>
                                <th>Birim Fiyat</th>
                                <th>Toplam Fiyat</th>
                                <th>Durum</th>
                                <th>İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.OrderId</td>
                                    <td>@item.Product.ProductName</td>
                                    <td>@item.Customer.CustomerName @item.Customer.CustomerSurname</td>
                                    <td class="text-center">@item.OrderCount</td>
                                    <td>@item.UnitPrice TL</td>
                                    <td>@item.TotalPrice TL</td>
                                    <td>@item.Status</td>

                                    <td style="display: flex; gap: 8px;">
                                        <a href="/Order/DeleteOrder/@item.OrderId" class="btn btn-outline-danger"><i class="fa fa-trash"></i></a>
                                        <a href="/Order/UpdateOrder/@item.OrderId" class="btn btn-outline-warning"><i class="fa fa-pencil-alt"></i></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <a href="/Order/CreateOrder/" class="btn btn-outline-info mt-2"><i class="fa fa-plus"></i>   Yeni Sipariş</a>
                </div>
                <div class="d-flex align-items-center justify-content-end mt-4 pt-3 border-top">
                    @Html.PagedListPager(Model, page => Url.Action("OrderListAsync2", new { page }), new PagedListRenderOptions
                    {
                        UlElementClasses = new[] { "pagination", "mb-0" },
                        LiElementClasses = new[] { "page-item" },
                        PageClasses = new[] { "page-link" }
                    })
                </div>
            </div>
        </div>
    </div>
</div> 