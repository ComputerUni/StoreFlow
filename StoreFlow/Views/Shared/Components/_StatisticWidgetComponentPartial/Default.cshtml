                <div class="d-flex justify-content-between align-items-center">
                    <div class="d-inline-block pt-3">
                        <div class="d-md-flex">
                            <h2 class="mb-0">@ViewBag.getIDIs4ProductName</h2>
                        </div>
                        <small class="text-white font-weight-bold">ID değeri 4 olan ürün adı.</small>
                    </div>
                    <div class="d-inline-block">
                        <i class="fas fa-coffee text-white icon-lg"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4 grid-margin">
        <div class="card" style="background: linear-gradient(135deg, #1e3a5f, #0d1f33); color: white;">
            <div class="card-body">
                <h4 class="card-title mb-0 text-white font-weight-bold">Stok sayısı 50-100 arasındaki ürün sayısı</h4>
