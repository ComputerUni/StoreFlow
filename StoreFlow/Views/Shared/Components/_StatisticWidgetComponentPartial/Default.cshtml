                        </div>
                        <small class="text-white font-weight-bold">Stok sayısı 50'den büyük 100'den küçük ürün sayısı</small>
                    </div>
                    <div class="d-inline-block">
                        <i class="fas fa-tag text-white icon-lg"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

