@model List<OrderStatusChartViewModel>
@using System.Text.Json

@{
    var statusLabels = Model.Select(x => x.Status).ToList();
    var statusCounts = Model.Select(x => x.Count).ToList();
}

<div class="col-md-6 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">
                <i class="fas fa-gift"></i> Sipariş Durumları
            </h4>
            <canvas id="orders-chart-status"></canvas>
            <div id="orders-chart-legend-status" class="orders-chart-legend-status"></div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const labels = @Html.Raw(JsonSerializer.Serialize(statusLabels));
    const counts = @Html.Raw(JsonSerializer.Serialize(statusCounts));

    const ctx = document.getElementById('orders-chart-status').getContext('2d');
    const chart = new Chart(ctx, {
        type: 'doughnut',
        data: {
            labels: labels,
            datasets: [{
                label: 'Sipariş Durumları',
                data: counts,
                backgroundColor: [
                    'rgba(13, 110, 253, 0.9)',  
                    'rgba(220, 53, 69, 0.9)',    
                    'rgba(25, 135, 84, 0.9)',    
                    'rgba(255, 193, 7, 0.9)',    
                    'rgba(111, 66, 193, 0.9)'    
                ],
                borderColor: '#ffffff',          
                borderWidth: 2                   
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: {
                    position: 'bottom'
                }
            }
        }
    });
</script>