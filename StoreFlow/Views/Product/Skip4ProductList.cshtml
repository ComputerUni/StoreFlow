@model List<Product>

@{
    ViewData["Title"] = "First5ProductList";
    Layout = "~/Views/Layout/Index.cshtml";
    int count = 0;
}

<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title font-weight-bold">İlk 5 Ürün Listesi</h4>
                <p class="card-description">
                    <code>Ürün ile ilgili işlemlerinizi buradan yapabilirsiniz.</code>
                </p>
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Ürün Adı</th>
                                <th>Fiyat</th>
                                <th>Kategori</th>
                                <th>Stok</th>
                                <th>İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                count++;
                                <tr>
                                    <td>@count</td>
                                    <td>@item.ProductName</td>
                                    <td>@item.ProductPrice</td>
                                    <td>@item.Category.CategoryName</td>
                                    <td>@item.ProductStock</td>

                                    <td style="display: flex; gap: 8px;">
                                        <a href="/Product/DeleteProduct/@item.ProductId" class="btn btn-outline-danger"><i class="fa fa-trash"></i></a>
                                        <a href="/Product/UpdateProduct/@item.ProductId" class="btn btn-outline-warning"><i class="fa fa-pencil-alt"></i></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <a href="/Product/CreateProduct/" class="btn btn-outline-info mt-2"><i class="fa fa-plus"></i>   Yeni Ürün</a>
                </div>

            </div>
        </div>
    </div>
</div>
